# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Python / backend
backend/.venv/
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/**/.pytest_cache/
*.pyc
backend/.env
.env

# ML artifacts (generated at train time)
#
# Written as `backend/models/*` rather than `backend/models/` so the directory
# stays traversable: git cannot re-include a file inside an EXCLUDED DIRECTORY,
# so a `!` negation under `backend/models/` would silently have no effect.
backend/models/*
backend/mlruns/
# Local MLflow store. mlflow 3.x requires a database backend (the file store is
# in maintenance mode), so an unset MLFLOW_TRACKING_URI now lands here; mlartifacts/
# is where it writes the logged model and artifacts.
backend/mlflow.db
backend/mlartifacts/
*.joblib

# The Safety NLP manifest is a GOVERNANCE RECORD, not a build artifact: it
# states which optional models may load and which approvals they carry, and
# tests/test_safety_nlp_manifest.py asserts the CHECKED-IN copy. While it was
# ignored, that test passed only for whoever had the file locally and failed in
# CI and on every fresh clone.
!backend/models/safety/
backend/models/safety/*
!backend/models/safety/manifest.json

# Generated reports (PDF report + collected per-job logs; regenerated by CI / app.ml.report)
reports/
backend/monitoring/drift_report.*
# Runtime telemetry (inference log + HITL ground-truth labels; per-deployment data)
backend/monitoring/*.jsonl

