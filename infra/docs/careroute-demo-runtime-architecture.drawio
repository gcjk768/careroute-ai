        <mxCell id="lg1" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="0" as="geometry" />
        </mxCell>
        <mxCell id="lg1-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="1" vertex="1" parent="lg1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg1-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Browser → ALB&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The patient console and the clinician dashboard are the same origin. The ALB's subnet CIDRs are the only peers the backend trusts for X-Forwarded-For — without that, every client shares one rate-limit bucket.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg1">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg2" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="82" as="geometry" />
        </mxCell>
        <mxCell id="lg2-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="lg2">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg2-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;ALB → Frontend (/*)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Default action serves the Next.js standalone server (Fargate Spot, :3000).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg2">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg3" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="164" as="geometry" />
        </mxCell>
        <mxCell id="lg3-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="lg3">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg3-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;ALB → Backend (/api/*)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A path rule sends the API to FastAPI (:8000). POST /api/triage/stream is Server-Sent Events held open for the whole run, so the ALB idle timeout is 120 s — the 60 s default cuts the stream mid-triage.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg3">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg4" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="246" as="geometry" />
        </mxCell>
        <mxCell id="lg4-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="lg4">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg4-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Backend → LLM API&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;OpenAI Chat Completions — or Claude, by pointing the same provider at Anthropic's OpenAI-compatible base URL. No key set = deterministic fallback, $0 spend.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg4">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg5" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="328" as="geometry" />
        </mxCell>
        <mxCell id="lg5-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="lg5">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg5-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Backend → OneMap&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Care Routing's real travel times and route geometry. Without the credential the agent still answers, but with a labelled straight-line estimate.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg5">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg6" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="410" as="geometry" />
        </mxCell>
        <mxCell id="lg6-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="lg6">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg6-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Secrets Manager → task&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The LLM key, the OneMap email/password (one JSON secret, so the pair rotates as a unit), the staff API key and the Grafana admin password are injected as container secrets — never in the task definition, code or state. The Onyx key joins them only when Onyx is configured.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg6">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg7" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="100" width="640" x="0" y="492" as="geometry" />
        </mxCell>
        <mxCell id="lg7-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="lg7">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg7-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Telemetry shipper → S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;A second container in the backend task (plain aws-cli) runs &lt;i&gt;aws s3 sync&lt;/i&gt; on the shared /telemetry volume — the inference log, clinician labels, monitor output and reports — into the artifacts bucket every interval, one-way and additive, so a redeploy never wipes history and the scheduled drift monitor reads the same paths.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg7">
          <mxGeometry height="100" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg8" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="100" width="640" x="0" y="600" as="geometry" />
        </mxCell>
        <mxCell id="lg8-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="8" vertex="1" parent="lg8">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg8-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;CloudWatch → SNS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Container logs from every task (awslogs) and the infrastructure alarms: backend CPU high, ALB target 5xx, and the *-deploy-rollback alarms ECS uses to roll a bad release back. They notify an SNS topic; alarm_email is unset in demo, so nothing is paged. The app-metric alarms exist only behind enable_app_metrics.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg8">
          <mxGeometry height="100" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg9" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="74" width="640" x="0" y="708" as="geometry" />
        </mxCell>
        <mxCell id="lg9-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="9" vertex="1" parent="lg9">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg9-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;ALB → Grafana (/grafana)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Grafana shares the app's load balancer instead of getting its own, so the demo keeps one entry point and one hourly charge. It is told to serve from that sub-path, which is also why its health check is /grafana/api/health.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg9">
          <mxGeometry height="74" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg10" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container">
          <mxGeometry height="104" width="640" x="0" y="790" as="geometry" />
        </mxCell>
        <mxCell id="lg10-b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="10" vertex="1" parent="lg10">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="lg10-t" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Prometheus → backend, Alertmanager, Grafana&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Prometheus resolves the backend through Cloud Map and scrapes :8000/metrics on the same 15s interval, evaluating the same alert.rules.yml as the app's compose stack. Firing alerts go to Alertmanager; Grafana queries Prometheus with PromQL, so the p95 rules CloudWatch cannot express work here.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="lg10">
          <mxGeometry height="104" width="580" x="52" as="geometry" />
        </mxCell>

        <mxCell id="lg-aux" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;fontStyle=0;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#425563,#D4D4D4);" value="&lt;div&gt;&lt;b&gt;Dashed = startup-only or optional (no request-path role, so no step number)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;b&gt;ECR → tasks&lt;/b&gt; — both images are pulled on startup. The app repo's pipeline builds them and pushes them tagged by commit SHA through a push-only IAM role it assumes over GitLab OIDC (trust keyed on the app project's numeric id); its deploy:trigger-infra job then starts this repo's pipeline with IMAGE_TAG=&amp;lt;sha&amp;gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;S3 artifacts&lt;/b&gt; — on in demo: the DVC remote the app's backend/.dvc/config points at, plus everything the telemetry shipper syncs. The app CI role can read and write it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Not drawn&lt;/b&gt; — an ADOT collector sidecar that would carry the app's Prometheus metrics into CloudWatch as EMF (enable_app_metrics, off in demo), and the optional API Gateway, RDS, MLflow, drift-monitor task and sub-agent tier, all off.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Onyx&lt;/b&gt; — self-hosted RAG, used only when base URL AND key are set; otherwise in-process TF-IDF." vertex="1" parent="legend-container">
          <mxGeometry height="230" width="620" x="0" y="910" as="geometry" />
        </mxCell>

      <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#E7157B;rounded=0;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="icon-backend" target="icon-cw"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8-label" value="awslogs" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=none;fontSize=11;fontFamily=Helvetica;fontColor=#E7157B;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" x="0.3" y="0" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>