# Playwright E2E output (regenerated by `npm run test:e2e` in frontend/).
# test-results/ holds per-failure traces and screenshots; playwright-report/ is
# the generated HTML report. Both are build output, not source.
frontend/test-results/
frontend/playwright-report/
frontend/.playwright/

# Courseware-alignment gates (PII egress, credential guard, guardrail score, canary).
pii-egress.json
no-live-credentials.json
guardrail-score.json
canary-ramp.json

# Pre-existing CI artifacts that were never ignored: the SBOM/AI-BOM outputs,
# the container-image scan reports, and the image tarballs (which are large).
ai-bom.json
sbom-*.cdx.json
trivy-*-image.json
*-image.tar

# graphify knowledge-graph build artifacts (18 MB; rebuild with /graphify)
graphify-out/


# archify visual-check evidence sidecars (screenshots + receipts, regenerate with
# `archify visual-check`); the delivered .html and its spec .json ARE committed.
docs/diagrams/*.visual-check.*

# A model trained from the repo root lands in ./models (the app reads backend/models);
# local model-safety scan output (fickling --check-safety).
/models/
safety_results.json
