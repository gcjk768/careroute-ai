<mxfile host="app.diagrams.net" type="device">
  <diagram name="CareRoute Logical Architecture" id="careroute-logical">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CareRoute AI — Logical Architecture (7 agents; Symptom-Intake orchestrates a safety-gated pipeline)" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1520" height="34" as="geometry" /></mxCell>
        <mxCell id="patient" value="Patient / Clinician&#10;(React / Next.js UI)&#10;/api → Next rewrite proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="185" height="78" as="geometry" /></mxCell>
        <mxCell id="sse" value="SSE event feed&#10;(live pipeline steps)&#10;+ keepalive comment every 10 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="185" height="70" as="geometry" /></mxCell>
        <mxCell id="backend" value="CareRoute Backend (FastAPI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="1300" height="830" as="geometry" /></mxCell>
        <mxCell id="ratelimit" value="Rate limiter&#10;(LLM10 · trusted-proxy aware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="103" width="150" height="64" as="geometry" /></mxCell>
        <mxCell id="guardin" value="Input guardrail&#10;6-layer defence-in-depth (LLM01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="103" width="190" height="64" as="geometry" /></mxCell>
        <mxCell id="redact" value="PII / PHI redaction (LLM02)&#10;masked before storage, incl.&#10;feedback + clinician notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="103" width="180" height="64" as="geometry" /></mxCell>
        <mxCell id="supervisor" value="SYMPTOM-INTAKE — orchestrator role (L3)&#10;new_session(): a private worker set per request · drives agents 1 → 7 in a fixed, safety-gated order · aggregates the cited response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="650" height="70" as="geometry" /></mxCell>
        <mxCell id="wk_intake" value="1 · Symptom-Intake&#10;(L2 · also orchestrates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_sev" value="2 · Severity-Classifier&#10;(L2 · ML + SHAP + counterfactual)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_safety" value="3 · Safety-Override&#10;(L2 semantic layer over an&#10;L1 raise-only floor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_route" value="4 · Care-Routing&#10;(L2 · bounded ReAct loop:&#10;2 tools, ≤ 3 turns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_hitl" value="5 · Human-in-the-Loop&#10;(L2 · tiered: HITL for red-flag /&#10;P1-P2 / low confidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_reflect" value="6 · Reflection / Critic&#10;(deterministic · escalation-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="wk_handoff" value="7 · Clinician-Handoff&#10;(L2 · only when escalated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380" y="250" width="160" height="72" as="geometry" /></mxCell>
        <mxCell id="mlmodel" value="ML severity model&#10;RandomForest + isotonic calibration&#10;SHAP (local + global) · counterfactual&#10;5-fold CV · SHAP-vs-surrogate agreement&#10;raise-only fairness post-processing&#10;drift (max PSI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="rag" value="Lexical RAG — TF-IDF cosine&#10;(bag-of-words, NOT vector search;&#10;Onyx is the optional embedding backend)&#10;guidance citations · off the event loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="509" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="safetynlp" value="Safety-NLP semantic layer&#10;NER · negation/assertion · similarity&#10;manifest-governed artifacts · add-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="718" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="routetools" value="Care-Routing tool registry&#10;CHAS directory · GoWhere hours&#10;OneMap: circuit breaker + case budget&#10;final check of the chosen clinic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="927" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="audit" value="Hash-chained audit log&#10;(SHA-256, tamper-evident)&#10;no raw patient text on the A2A bus&#10;attributed to the signed-in clinician" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1136" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="memory" value="Store: cases / escalations&#10;+ episodic session memory (digest-verified)&#10;+ HITL ground-truth log, joined to the&#10;inference log → live LABELLED metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1345" y="430" width="195" height="100" as="geometry" /></mxCell>
        <mxCell id="guardcontent" value="UNTRUSTED-CONTENT SCREEN (LLM04 / LLM08 · ASI06) — retrieved (Onyx) and remembered (prior-visit) text is NFKC-sanitised, length-capped and screened before it can reach any prompt; a flagged item is dropped, counted and audited, never forwarded &quot;for the model to ignore&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="1240" height="48" as="geometry" /></mxCell>
        <mxCell id="guardout" value="OUTPUT GUARDRAIL (LLM05) — screens the rationale and the clinician-handoff summary for prompt-leak / injection before the final SSE event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="632" width="1240" height="48" as="geometry" /></mxCell>
        <mxCell id="llmchain" value="LLM provider chain  (every worker: LLM-first → deterministic fallback):   OpenAI API  →  deterministic rules&#10;every system prompt carries the shared embedded-instruction guard (LLM01) · per-provider circuit breaker (ASI08) · kill switch forces deterministic-only (ASI10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="300" y="706" width="1240" height="64" as="geometry" /></mxCell>
        <mxCell id="footnote" value="Concurrency &amp; transport — workers keep per-case state, so every request gets its own worker set (new_session); shared across requests only: clinic dataset, hours snapshot, OneMap client + token, route cache, ML model. The stream emits a keepalive comment every 10 s because the Next /api proxy aborts an upstream that is silent for 30 s. Tool use is allow-listed and enforced at every call site (ml.predict, llm.complete, rag.retrieve, safety_nlp.classify, clinic.lookup, facility.hours.lookup, travel.estimate, escalation.create, critique); Care-Routing is the one worker whose model CHOOSES among its tools, inside a bounded ReAct loop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="794" width="1240" height="76" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="patient" target="ratelimit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1lbl" value="POST&#10;/api/triage/stream" style="text;html=1;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="150" y="94" width="110" height="30" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ratelimit" target="guardin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="guardin" target="redact"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="redact" target="supervisor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="orch" value="orchestrates agents 1 → 7 (safety-gated order; 7 only if escalated)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;exitX=0.05;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supervisor" target="wk_intake"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="210" /><mxPoint x="380" y="210" /></Array></mxGeometry></mxCell>
        <mxCell id="u1" value="uses" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wk_sev" target="mlmodel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="u2" value="grounds" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.75;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="wk_sev" target="rag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="u5" value="verifies candidates" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wk_route" target="routetools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="u3" value="every step logs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wk_safety" target="audit"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="396" /><mxPoint x="1233" y="396" /></Array></mxGeometry></mxCell>
        <mxCell id="u7" value="adds signals (never lowers)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wk_safety" target="safetynlp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="u4" value="recall / escalate / label" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="wk_hitl" target="memory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="u6" value="handoff packet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=9;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="wk_handoff" target="memory"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="uc1" value="retrieved text" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=9;exitX=0.5;exitY=1;entryX=0.18;entryY=0;" edge="1" parent="1" source="rag" target="guardcontent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="uc2" value="recalled prior visit" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#b85450;fontSize=9;exitX=0.5;exitY=1;entryX=0.92;entryY=0;" edge="1" parent="1" source="memory" target="guardcontent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="g1" value="aggregate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="supervisor" target="guardout"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1556" y="135" /><mxPoint x="1556" y="656" /></Array></mxGeometry></mxCell>
        <mxCell id="g2" value="cited result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="guardout" target="sse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="656" /><mxPoint x="250" y="365" /></Array></mxGeometry></mxCell>
        <mxCell id="g3" value="response" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=9;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sse" target="patient"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
