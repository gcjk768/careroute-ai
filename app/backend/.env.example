# ── LLM provider chain ───────────────────────────────────────────────────────
# Order in which providers are tried (first usable answer wins). If ALL fail,
# the agents fall back to deterministic rule-based logic, so the app still runs.
# The hosted OpenAI API is the only provider. The local CLI and Ollama
# providers were removed (2026-09-23): neither exists in the deployed service.
LLM_PROVIDER_ORDER=openai

# OpenAI / ChatGPT API — used only when OPENAI_API_KEY is set.
# NEVER commit a real key. Keep it in .env (gitignored) or a secrets manager.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
# Model by task weight — the LLM router (app/llm.py ROUTES) sends each task to a tier:
#   FAST  intake normalisation, routing, handoff summary, interview question
#   DEEP  acuity classification, semantic red-flag check, Reflection critic
#   MAX   any call escalated as hard (low confidence, thin evidence, Reflection re-run)
# Empty = the code defaults (app/llm.py _TIER_DEFAULTS), chosen by the 100-scenario
# head-to-head of 2026-09-27. Cheaper / faster, more conservative alternative:
# gpt-4o-mini / gpt-4.1-mini / gpt-4.1. The provider drops parameters a model rejects.
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_DEEP=gpt-5.4
OPENAI_MODEL_MAX=gpt-5.5
# Sent only to reasoning models (gpt-5*, o-series); "low" keeps latency close to gpt-4o-mini's.
OPENAI_REASONING_EFFORT=low

# Optional per-case LLM tracing (app/tracing.py); each sink is off while empty.
# Local Langfuse: `docker compose --profile tracing up`, UI http://localhost:3001,
# keys preset by its headless init: pk-lf-careroute-local / sk-lf-careroute-local.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
# LangSmith is hosted: masked prompts leave the machine.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careroute

# Put a 160-char excerpt of a failed LLM response into exceptions/logs. LOCAL
# DEBUG ONLY — llm.py otherwise never logs prompt/response content (PHI).
CAREROUTE_DEBUG_LLM=0

# Safety NLP shadow pipeline (optional; deterministic Safety still works when off)
CAREROUTE_SAFETY_NLP=0
CAREROUTE_SAFETY_NLP_TRANSLATION_NLLB=0
CAREROUTE_SAFETY_NLP_TRANSLATION_MADLAD=0
# Optional direct multilingual comparator used to surface cross-model disagreement.
CAREROUTE_SAFETY_NLP_DIRECT_NLI=0
CAREROUTE_SAFETY_MODEL_MANIFEST=models/safety/manifest.json
CAREROUTE_SAFETY_MODEL_CACHE=models/safety/cache
CAREROUTE_SAFETY_NLP_DEVICE=cpu
CAREROUTE_SAFETY_NLP_TIMEOUT_MS=1000
CAREROUTE_SAFETY_NLP_MAX_INPUT_CHARS=2000
CAREROUTE_SAFETY_PROTOTYPE_SEMANTIC_ACTIVATION=0
# Conservative educational-prototype defaults. Tune only from a versioned benchmark.
CAREROUTE_SAFETY_NLP_ACTIVATION_THRESHOLD=0.85
CAREROUTE_SAFETY_LLM_ACTIVATION_THRESHOLD=0.85
CAREROUTE_SAFETY_SEMANTIC_REVIEW_THRESHOLD=0.60
# Development integration test only: force sanitized uncertainty telemetry so
# the Phase 5 bounded LLM can be exercised through the full API pipeline.
CAREROUTE_SAFETY_NLP_TEST_FORCE_UNCERTAINTY=0

# Safety bounded LLM adjudication (Phase 5)
# Off by default. Uses the OpenAI provider (needs OPENAI_API_KEY).
CAREROUTE_SAFETY_LLM=0
CAREROUTE_SAFETY_LLM_PROVIDER_ORDER=openai
CAREROUTE_SAFETY_LLM_MODEL=gpt-4o-mini
CAREROUTE_SAFETY_LLM_TIMEOUT_MS=5000

# ── OneMap (Care Routing travel estimates + route geometry) ──────────────────
# Free account at https://www.onemap.gov.sg. Without these the routing agent
# still runs and returns an explicitly labelled local estimate instead.
# NOTE: the app loads this file from the REPOSITORY ROOT (../.env), not here.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ── GitLab ───────────────────────────────────────────────────────────────────
# Personal Access Token, only needed for tooling that talks to the GitLab API
# (`glab`, CI helper scripts). Plain `git push` does not need it: the Windows
# Credential Manager already supplies the credential. NEVER commit a real token.
# NOTE: like ONEMAP above, put the real value in the REPOSITORY ROOT .env.
GITLAB_TOKEN=

# ── SSE transport ─────────────────────────────────────────────────────────────
# Keepalive comment frame cadence while the pipeline is silent. Next's /api
# rewrite aborts an upstream that is idle for 30 s without ending the browser
# response, so keep this well under 30. 0 disables. See docs/vault/Changelog.md.
CAREROUTE_SSE_HEARTBEAT_SECONDS=10

# ── HTTP edge ─────────────────────────────────────────────────────────────────
# Peers (IPs or CIDRs, comma-separated) whose X-Forwarded-For we believe when
# picking a rate-limit key. Empty = trust nobody, correct when exposed directly.
CAREROUTE_TRUSTED_PROXIES=
# Browser origins allowed to call this API (comma-separated). Blank = the two
# localhost dev servers. Never "*": allow_credentials is on.
CAREROUTE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
